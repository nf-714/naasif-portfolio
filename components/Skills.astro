---
const skillGroups = [
	{
		label: "AI Engineering",
		items: [
			{
				number: "01",
				title: "Machine Learning",
				body: "Prediction, classification, deep learning, and NLP foundations applied to practical business problems.",
			},
			{
				number: "02",
				title: "Agentic AI Engineering",
				body: "Build tool-using agents with context, guardrails, fallbacks, and human review.",
			},
			{
				number: "03",
				title: "AI Automation",
				body: "Connect scripts, agents, APIs, and existing tools around a real business workflow.",
			},
			{
				number: "04",
				title: "Web Applications + Internal Tools",
				body: "Build interfaces, dashboards, and internal tools that make systems usable.",
			},
		],
	},
	{
		label: "GTM + Analytics",
		items: [
			{
				number: "05",
				title: "GTM + Business Development",
				body: "Lead research, prospecting, messaging, qualification, and follow-up connected to the revenue path.",
			},
			{
				number: "06",
				title: "Marketing Operations",
				body: "Connect content, SEO, lead capture, CRM, and reporting into a measurable path.",
			},
			{
				number: "07",
				title: "Business Analytics",
				body: "Turn pipeline, conversion, and operational data into decisions and next actions.",
			},
			{
				number: "08",
				title: "Revenue Operations + CRM",
				body: "Design lead pipelines, nurture, tasks, integrations, and reporting around ownership.",
			},
		],
	},
];
---

<section id="skills" class="skills" aria-labelledby="skills-title">
	<div class="skills__inner">
		<header class="skills__header">
			<p class="skills__marker" data-reveal="up">02 / Role lanes</p>
			<h2 id="skills-title" data-scroll-text>Three role lanes, one way of working.</h2>
			<p class="skills__intro" data-reveal="up">
				I move between technical systems, commercial execution, and business analysis without losing sight of the next action.
			</p>
		</header>

		<div class="skills__groups">
			{
				skillGroups.map((group, groupIndex) => (
					<section
						class:list={["skills__group", { "skills__group--accent": groupIndex === 1 }]}
						aria-labelledby={`skills-group-${groupIndex}`}
					>
						<h3 id={`skills-group-${groupIndex}`}>{group.label}</h3>
						<div class="skills__list">
							{
								group.items.map((skill, index) => (
									<article
										class="skills__item"
										data-reveal="up"
										style={`--reveal-delay: ${(groupIndex * 4 + index) * 55}ms;`}
									>
										<span class="skills__number" aria-hidden="true">{skill.number}</span>
										<div>
											<h4>{skill.title}</h4>
											<p>{skill.body}</p>
										</div>
									</article>
								))
							}
						</div>
					</section>
				))
			}
		</div>
	</div>
</section>

<style>
	.skills {
		--skills-surface: #09090b;
		--skills-ink: var(--color-secondary);
		--skills-muted: rgba(255, 255, 255, 0.68);
		--skills-dim: rgba(255, 255, 255, 0.42);
		--skills-rule: rgba(255, 255, 255, 0.15);
		padding: clamp(6.5rem, 10vw, 10rem) 1.5rem;
		background: var(--skills-surface);
		color: var(--skills-ink);
	}

	.skills__inner {
		width: min(100%, 93rem);
		margin-inline: auto;
	}

	.skills__header {
		max-width: 58rem;
		margin-bottom: clamp(3.75rem, 7vw, 6.5rem);
	}

	.skills__marker {
		margin: 0 0 1.8rem;
		font-size: 0.78rem;
		font-weight: 600;
		letter-spacing: 0.16em;
		color: var(--color-main);
		text-transform: uppercase;
	}

	.skills__header h2 {
		--text-progress: 0;
		max-width: 54rem;
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(4.8rem, 8vw, 7.6rem);
		font-weight: 500;
		line-height: 0.8;
		letter-spacing: -0.035em;
		text-wrap: balance;
	}

	:global(.motion-ready) .skills__header h2 {
		background-image: linear-gradient(to right, var(--skills-ink) 50%, rgba(255, 255, 255, 0.16) 50%);
		background-position: calc(100% - var(--text-progress) * 100%) 0;
		background-size: 200% 100%;
		background-clip: text;
		color: transparent;
		-webkit-background-clip: text;
	}

	.skills__intro {
		max-width: 33rem;
		margin: 2rem 0 0;
		font-size: clamp(1rem, 1.2vw, 1.12rem);
		line-height: 1.6;
		color: var(--skills-muted);
	}

	.skills__groups {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem;
	}

	.skills__group {
		border: 1px solid var(--skills-rule);
		background: rgba(255, 255, 255, 0.025);
	}

	.skills__group--accent {
		background: rgba(23, 59, 255, 0.09);
	}

	.skills__group > h3 {
		margin: 0;
		padding: 1.4rem clamp(1.5rem, 3vw, 3rem);
		border-bottom: 1px solid var(--skills-rule);
		font-size: 0.76rem;
		font-weight: 600;
		letter-spacing: 0.16em;
		color: var(--color-main);
		text-transform: uppercase;
	}

	.skills__item {
		display: grid;
		grid-template-columns: 2.8rem minmax(0, 1fr);
		gap: 1.25rem;
		padding: clamp(1.5rem, 2.75vw, 2.4rem) clamp(1.5rem, 3vw, 3rem);
		border-bottom: 1px solid var(--skills-rule);
	}

	.skills__item:last-child {
		border-bottom: 0;
	}

	.skills__number {
		padding-top: 0.15rem;
		font-size: 0.74rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		color: var(--skills-dim);
	}

	.skills__item h4 {
		margin: 0 0 0.55rem;
		font-size: clamp(1.2rem, 1.8vw, 1.6rem);
		font-weight: 600;
		line-height: 1.08;
		letter-spacing: -0.03em;
	}

	.skills__item p {
		max-width: 30rem;
		margin: 0;
		font-size: clamp(0.95rem, 1.12vw, 1.05rem);
		line-height: 1.55;
		color: var(--skills-muted);
	}

	@media (max-width: 820px) {
		.skills__groups {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 620px) {
		.skills {
			padding: 6rem 1rem;
		}

		.skills__header {
			margin-bottom: 3.5rem;
		}

		.skills__header h2 {
			font-size: clamp(4.2rem, 19vw, 5.8rem);
		}

		.skills__groups {
			gap: 0.75rem;
		}

		.skills__item {
			grid-template-columns: 2.25rem minmax(0, 1fr);
			gap: 0.8rem;
		}
	}
</style>
