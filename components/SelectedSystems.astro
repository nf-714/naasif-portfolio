---
const systems = [
	{
		name: "Scalaar AI",
		role: "AI systems for lean growth teams.",
		description:
			"A practical operating system that connects automation, workflows, and growth, helping lean teams scale without adding more process or manual overhead.",
		image: "/assets/images/selected-system-01.png",
		imageAlt: "Scalaar AI project artwork",
		width: 2124,
		height: 1448,
	},
	{
		name: "Filo AI",
		role: "An AI sales agent for continuous follow-up.",
		description:
			"An AI sales agent that captures, qualifies, and follows up with leads, keeping every conversation moving toward a clear next action.",
		image: "/assets/images/selected-system-02.png",
		imageAlt: "Filo AI project artwork",
		width: 2136,
		height: 1448,
	},
];
---

<section id="systems" class="systems" aria-labelledby="systems-title">
	<div class="systems__inner">
		<header class="systems__header">
			<p class="systems__marker" data-reveal="up"><span>01 /</span> Building now</p>
			<div>
				<h2 id="systems-title" data-scroll-text>Two products built around the work growth teams repeat every day.</h2>
				<p class="systems__intro" data-reveal="up">
					I am focused on products that turn repetitive growth work into clear, usable systems.
				</p>
			</div>
		</header>

		<div class="systems__grid">
			{
				systems.map((system, index) => (
					<article class="system" data-reveal="up" style={`--reveal-delay: ${index * 90}ms;`}>
						<figure class="system__visual">
							<img
								src={system.image}
								alt={system.imageAlt}
								width={system.width}
								height={system.height}
								loading="lazy"
								decoding="async"
							/>
						</figure>

						<div class="system__copy">
							<h3>{system.name}</h3>
							<div>
								<p class="system__role">{system.role}</p>
								<p class="system__description">{system.description}</p>
							</div>
						</div>
					</article>
				))
			}
		</div>
	</div>
</section>

<style>
	.systems {
		--systems-ink: var(--color-secondary);
		--systems-muted: rgba(255, 255, 255, 0.64);
		padding: clamp(7rem, 11vw, 11rem) 1.5rem;
		background: #09090b;
		color: var(--systems-ink);
	}

	.systems__inner {
		width: min(100%, 93rem);
		margin-inline: auto;
	}

	.systems__header {
		display: grid;
		grid-template-columns: minmax(12rem, 0.85fr) minmax(0, 2fr);
		gap: clamp(2rem, 6vw, 7rem);
		align-items: start;
		margin-bottom: clamp(4rem, 7vw, 7rem);
	}

	.systems__marker {
		margin: 0;
		padding-top: 0.8rem;
		font-size: 0.78rem;
		font-weight: 600;
		letter-spacing: 0.16em;
		color: var(--color-main);
		text-transform: uppercase;
	}

	.systems__header h2 {
		--text-progress: 0;
		max-width: 47rem;
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(4.8rem, 7.5vw, 6rem);
		font-weight: 500;
		line-height: 0.82;
		letter-spacing: -0.028em;
		text-wrap: balance;
	}

	:global(.motion-ready) .systems__header h2 {
		background-image: linear-gradient(to right, var(--systems-ink) 50%, rgba(255, 255, 255, 0.16) 50%);
		background-position: calc(100% - var(--text-progress) * 100%) 0;
		background-size: 200% 100%;
		background-clip: text;
		color: transparent;
		-webkit-background-clip: text;
	}

	.systems__intro {
		max-width: 34rem;
		margin: 2.2rem 0 0;
		font-size: clamp(1rem, 1.2vw, 1.12rem);
		line-height: 1.6;
		color: var(--systems-muted);
	}

	.systems__grid {
		display: grid;
		grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
		gap: clamp(2rem, 5vw, 5rem);
		align-items: start;
	}

	.system:nth-child(2) {
		margin-top: clamp(3rem, 8vw, 8rem);
	}

	.system__visual {
		margin: 0;
		overflow: hidden;
	}

	.system__visual img {
		width: 100%;
		height: auto;
		transition: transform 800ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.system:hover .system__visual img {
		transform: scale(1.025);
	}

	.system__copy {
		display: grid;
		grid-template-columns: minmax(9rem, 0.65fr) minmax(0, 1.35fr);
		gap: clamp(1.5rem, 3vw, 3rem);
		align-items: start;
		padding-top: 1.6rem;
	}

	.system__copy h3 {
		margin: 0;
		font-size: clamp(1.45rem, 2vw, 2rem);
		font-weight: 600;
		line-height: 1;
		letter-spacing: -0.035em;
	}

	.system__role,
	.system__description {
		margin: 0;
		font-size: clamp(0.98rem, 1.15vw, 1.08rem);
		line-height: 1.55;
	}

	.system__role {
		font-weight: 600;
		color: var(--systems-ink);
	}

	.system__description {
		margin-top: 0.75rem;
		color: var(--systems-muted);
	}

	@media (max-width: 850px) {
		.systems__header {
			grid-template-columns: minmax(10rem, 0.65fr) minmax(0, 1.6fr);
		}

		.systems__grid {
			grid-template-columns: 1fr;
			gap: 4.5rem;
		}

		.system:nth-child(2) {
			margin-top: 0;
		}
	}

	@media (max-width: 680px) {
		.systems {
			padding: 6rem 1rem;
		}

		.systems__header {
			grid-template-columns: 1fr;
			gap: 2rem;
			margin-bottom: 3.75rem;
		}

		.systems__marker {
			padding-top: 0;
		}

		.systems__header h2 {
			font-size: clamp(4rem, 18vw, 5.6rem);
		}

		.system__copy {
			grid-template-columns: 1fr;
			gap: 1rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.system__visual img {
			transition: none;
		}

		.system:hover .system__visual img {
			transform: none;
		}
	}
</style>
