---
const year = new Date().getFullYear();

const links = [
	{ label: "Introduction", href: "#top" },
	{ label: "Selected work", href: "#systems" },
	{ label: "Role lanes", href: "#skills" },
	{ label: "What I build", href: "#services" },
	{ label: "How I work", href: "#process" },
	{ label: "Current projects", href: "#building-now" },
	{ label: "Contact", href: "#contact" },
];
---

<footer id="contact" class="footer">
	<div class="footer__top">
		<div class="footer__pitch" data-reveal="up">
			<p>AI Engineer and growth systems operator connecting data, GTM, and execution.</p>
			<div class="footer__status"><i></i> Open to AI engineering, GTM, growth, business development, marketing, analytics, and strategy roles.</div>
		</div>

		<nav class="footer__nav" aria-label="Footer navigation" data-reveal="up" style="--reveal-delay: 90ms;">
			<h2>Quick links</h2>
			<div>
				{links.map((link) => <a href={link.href}>{link.label}</a>)}
			</div>
		</nav>

		<div class="footer__contact" data-reveal="up" style="--reveal-delay: 160ms;">
			<h2>Contact</h2>
			<p>Dhaka, Bangladesh<br />Working worldwide · GMT+6</p>
			<a href="#top">Back to the introduction <span aria-hidden="true">↗</span></a>
		</div>
	</div>

	<a
		class="footer__wordmark"
		href="#top"
		aria-label="Nasif Fuad - back to top"
		data-reveal="up"
		style="--reveal-distance: 4rem; --reveal-duration: 900ms;"
	>
		Nasif.Fuad
	</a>

	<div class="footer__bottom" data-reveal="up" style="--reveal-delay: 180ms;">
		<span>© {year} Nasif Fuad.</span>
		<span>Designed &amp; built with Astro.</span>
	</div>
</footer>

<style>
	.footer {
		--footer-blue: var(--color-main);
		--footer-ink: var(--color-ink);
		--footer-muted: var(--color-muted);
		--footer-tint: var(--color-accent-soft);
		--footer-rule: var(--color-rule);
		overflow: hidden;
		padding: clamp(6rem, 9vw, 8rem) 1.5rem 2rem;
		background: var(--color-surface);
		color: var(--footer-blue);
	}

	.footer__top {
		display: grid;
		grid-template-columns: 1.2fr 1fr 0.8fr;
		gap: clamp(3rem, 7vw, 7rem);
		width: min(100%, 84.5rem);
		margin-inline: auto;
	}

	.footer__pitch > p {
		max-width: 29rem;
		margin: 0 0 2rem;
		font-family: var(--font-display);
		font-size: clamp(3.4rem, 5.6vw, 5.8rem);
		font-weight: 500;
		line-height: 0.78;
		letter-spacing: -0.025em;
	}

	.footer__status {
		display: flex;
		align-items: center;
		gap: 0.65rem;
		font-size: 0.78rem;
		font-weight: 600;
		color: var(--footer-muted);
	}

	.footer__status i {
		width: 0.5rem;
		aspect-ratio: 1;
		border-radius: 50%;
		background: var(--footer-blue);
		box-shadow: 0 0 0 0.3rem rgba(39, 1, 255, 0.12);
	}

	.footer h2 {
		margin: 0 0 1.5rem;
		font-size: 0.84rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.footer h2::before {
		display: inline-block;
		width: 0.48rem;
		aspect-ratio: 1;
		margin-right: 0.6rem;
		border-radius: 50%;
		background: var(--footer-blue);
		content: "";
	}

	.footer__nav > div {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem;
	}

	.footer__nav a {
		padding: 0.7rem 1rem 0.62rem;
		border-radius: 999px;
		background: var(--footer-tint);
		color: var(--footer-blue);
		font-size: 0.7rem;
		font-weight: 600;
		letter-spacing: 0.05em;
		text-decoration: none;
		text-transform: uppercase;
		transition: background-color 180ms ease, color 180ms ease;
	}

	.footer__nav a:hover,
	.footer__nav a:focus-visible {
		background: var(--footer-blue);
		color: #fff;
	}

	.footer__contact p {
		margin: 0 0 1.25rem;
		font-size: 0.95rem;
		line-height: 1.65;
		color: var(--footer-muted);
	}

	.footer__contact > a {
		display: inline-flex;
		gap: 0.4rem;
		color: var(--footer-blue);
		font-size: 0.88rem;
		text-underline-offset: 0.3rem;
	}

	.footer__wordmark {
		display: block;
		width: min(100%, 93rem);
		margin: clamp(5rem, 10vw, 9rem) auto 0;
		font-family: var(--font-display);
		font-size: clamp(7rem, 18.3vw, 18rem);
		font-weight: 500;
		line-height: 0.58;
		letter-spacing: -0.045em;
		text-align: center;
		text-decoration: none;
		white-space: nowrap;
		color: var(--footer-ink);
	}

	.footer__bottom {
		display: flex;
		justify-content: space-between;
		width: min(100%, 84.5rem);
		margin: 2.4rem auto 0;
		padding-top: 1.3rem;
		border-top: 1px solid var(--footer-rule);
		font-size: 0.78rem;
		color: var(--footer-muted);
	}

	@media (max-width: 850px) {
		.footer__top {
			grid-template-columns: 1fr 1fr;
		}

		.footer__pitch {
			grid-column: 1 / -1;
		}
	}

	@media (max-width: 600px) {
		.footer {
			padding: 5.5rem 1rem 1.5rem;
		}

		.footer__top {
			grid-template-columns: 1fr;
			gap: 3rem;
		}

		.footer__pitch {
			grid-column: auto;
		}

		.footer__wordmark {
			font-size: clamp(5rem, 27vw, 7.5rem);
		}

		.footer__bottom {
			flex-direction: column;
			gap: 0.45rem;
		}
	}
</style>
