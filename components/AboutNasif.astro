---
const portrait = "/assets/images/nasif-multidisciplinary.png";
---

<section class="about-nasif" aria-labelledby="about-nasif-title">
	<div class="about-nasif__inner">
		<figure class="about-nasif__portrait" data-reveal="left" style="--reveal-distance: 2rem;">
			<img
				src={portrait}
				alt="Nasif Fuad in a charcoal suit and clear glasses"
				width="670"
				height="798"
				loading="lazy"
				decoding="async"
			/>
		</figure>

		<div class="about-nasif__content">
			<p class="about-nasif__label" data-reveal="up">AI <span aria-hidden="true">×</span> Growth + Product</p>
			<h2 id="about-nasif-title" data-reveal="up" style="--reveal-delay: 80ms; --reveal-distance: 2.75rem;">
				I work at the intersection of <strong>product judgment, growth thinking, and applied AI engineering.</strong>
			</h2>
			<div class="about-nasif__copy" data-reveal="up" style="--reveal-delay: 170ms; --reveal-distance: 2rem;">
				<p>
					My supply-chain background trained me to see systems, dependencies, and operational bottlenecks. Today, I use that perspective to build AI products and revenue infrastructure that connect strategy to execution.
				</p>
				<p>
					The work spans agentic workflows, GTM systems, analytics, and product experiments, always grounded in the next action a team needs to own.
				</p>
			</div>
		</div>
	</div>
</section>

<style>
	.about-nasif {
		position: relative;
		overflow: hidden;
		padding: clamp(7rem, 11vw, 11rem) 1.5rem;
		background: var(--color-surface-alt);
		color: var(--color-ink);
	}

	.about-nasif::before {
		position: absolute;
		inset: 0;
		background: linear-gradient(90deg, transparent 49.96%, var(--color-rule) 50%, transparent 50.04%);
		content: "";
		pointer-events: none;
	}

	.about-nasif__inner {
		position: relative;
		display: grid;
		grid-template-columns: minmax(16rem, 0.82fr) minmax(0, 1.18fr);
		gap: clamp(3rem, 9vw, 11rem);
		align-items: center;
		width: min(100%, 82rem);
		margin-inline: auto;
	}

	.about-nasif__portrait {
		position: relative;
		margin: 0;
		background: #17171e;
	}

	.about-nasif__portrait::after {
		position: absolute;
		inset: 0;
		border: 1px solid rgba(255, 255, 255, 0.14);
		content: "";
		pointer-events: none;
	}

	.about-nasif__portrait img {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 670 / 798;
		object-fit: cover;
	}

	.about-nasif__content {
		max-width: 43rem;
	}

	.about-nasif__label {
		margin: 0 0 clamp(2.2rem, 4vw, 3.8rem);
		font-size: clamp(1rem, 1.35vw, 1.22rem);
		font-weight: 600;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.about-nasif__label span {
		color: var(--color-main);
		font-size: 1.55em;
		font-weight: 400;
		vertical-align: -0.06em;
	}

	.about-nasif h2 {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(3.55rem, 5.4vw, 5.85rem);
		font-weight: 500;
		line-height: 0.88;
		letter-spacing: -0.03em;
		text-wrap: balance;
	}

	.about-nasif h2 strong {
		font-weight: inherit;
		color: var(--color-main);
	}

	.about-nasif__copy {
		max-width: 38rem;
		margin-top: clamp(2.5rem, 5vw, 4.25rem);
		padding-top: 1.35rem;
		border-top: 1px solid var(--color-rule);
	}

	.about-nasif__copy p {
		margin: 0;
		font-size: clamp(1rem, 1.35vw, 1.18rem);
		font-weight: 500;
		line-height: 1.62;
		color: var(--color-muted);
	}

	.about-nasif__copy p + p {
		margin-top: 1.1rem;
	}

	@media (max-width: 800px) {
		.about-nasif {
			padding: 6.25rem 1rem;
		}

		.about-nasif::before {
			background: none;
		}

		.about-nasif__inner {
			grid-template-columns: minmax(0, 28rem) minmax(0, 1fr);
			gap: clamp(2.25rem, 6vw, 4rem);
			align-items: start;
		}

		.about-nasif h2 {
			font-size: clamp(3.25rem, 7.8vw, 4.7rem);
		}
	}

	@media (max-width: 620px) {
		.about-nasif__inner {
			grid-template-columns: 1fr;
			gap: 3rem;
		}

		.about-nasif__portrait {
			width: min(100%, 27rem);
		}

		.about-nasif__label {
			margin-bottom: 2rem;
			font-size: 0.86rem;
		}

		.about-nasif h2 {
			font-size: clamp(3.15rem, 14vw, 4.35rem);
			line-height: 0.9;
		}

		.about-nasif__copy {
			margin-top: 2.5rem;
		}
	}
</style>
