---
const capabilities = [
	{
		number: "01",
		title: "Understand the context",
		description:
			"Learn the audience, business process, data, constraints, tools, and success signal.",
	},
	{
		number: "02",
		title: "Find the signal",
		description:
			"Identify where time, information, opportunities, or decisions are getting lost.",
	},
	{
		number: "03",
		title: "Build the system",
		description:
			"Create the smallest useful combination of code, AI, analytics, integrations, and human review.",
	},
	{
		number: "04",
		title: "Improve the next action",
		description:
			"Put the work into use, observe what happens, and make the next version easier to run.",
	},
];
---

<section id="consulting" class="consulting" aria-labelledby="consulting-title">
	<div class="consulting__inner">
		<header class="consulting__header">
			<p class="consulting__marker" data-reveal="up">
				<span>03 /</span> How I contribute
			</p>
			<h2 id="consulting-title" data-scroll-text>
				<span>I connect technical work to </span>
				<span>the decision it needs to change.</span>
			</h2>
		</header>

		<div class="consulting__body">
			<div class="consulting__grid">
				{
					capabilities.map((capability, index) => (
						<article
							class="consulting__capability"
							data-reveal="up"
							style={`--reveal-delay: ${index * 55}ms;`}
						>
							<span class="consulting__number">{capability.number}</span>
							<div>
								<h3>{capability.title}</h3>
								<p>{capability.description}</p>
							</div>
						</article>
					))
				}
			</div>

			<figure class="consulting__visual" data-reveal="left" style="--reveal-distance: 3.5rem;">
				<img
					src="/assets/images/consulting-systems.jpg"
					alt="Monumental concrete architecture illuminated by cobalt blue light"
					width="1122"
					height="1402"
					loading="lazy"
				/>
			</figure>
		</div>
	</div>
</section>

<style>
	.consulting {
		--consulting-surface: var(--color-surface-alt);
		--consulting-ink: var(--color-ink);
		--consulting-muted: var(--color-muted);
		--consulting-dim: var(--color-dim);
		--consulting-rule: var(--color-rule);
		padding: clamp(7rem, 10vw, 10rem) 1.5rem;
		background: var(--consulting-surface);
		color: var(--consulting-ink);
	}

	.consulting__inner {
		width: min(100%, 93rem);
		margin-inline: auto;
	}

	.consulting__header {
		display: grid;
		grid-template-columns: minmax(12rem, 0.85fr) minmax(0, 2fr);
		gap: clamp(2rem, 6vw, 7rem);
		align-items: start;
		margin-bottom: clamp(4.5rem, 7vw, 7rem);
	}

	.consulting__marker {
		margin: 0;
		padding-top: 0.8rem;
		font-size: 0.78rem;
		font-weight: 600;
		letter-spacing: 0.16em;
		color: var(--consulting-dim);
		text-transform: uppercase;
	}

	.consulting__marker span {
		color: var(--color-main);
	}

	.consulting__header h2 {
		--text-progress: 0;
		max-width: 47rem;
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(4.8rem, 7.5vw, 6rem);
		font-weight: 500;
		line-height: 0.82;
		letter-spacing: -0.028em;
		text-wrap: balance;
	}

	:global(.motion-ready) .consulting__header h2 {
		background-image: linear-gradient(
			to right,
			var(--consulting-ink) 50%,
			#d6d6df 50%
		);
		background-position: calc(100% - var(--text-progress) * 100%) 0;
		background-size: 200% 100%;
		background-clip: text;
		color: transparent;
		-webkit-background-clip: text;
	}

	.consulting__body {
		display: grid;
		grid-template-columns: minmax(0, 1.9fr) minmax(21rem, 0.82fr);
		gap: 1.25rem;
		align-items: stretch;
	}

	.consulting__grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		border: 1px solid var(--consulting-rule);
	}

	.consulting__capability {
		display: flex;
		min-height: 19rem;
		flex-direction: column;
		justify-content: space-between;
		gap: 2.5rem;
		padding: clamp(2.1rem, 3.5vw, 3.5rem);
	}

	.consulting__capability:nth-child(odd) {
		border-right: 1px solid var(--consulting-rule);
	}

	.consulting__capability:nth-child(-n + 2) {
		border-bottom: 1px solid var(--consulting-rule);
	}

	.consulting__number {
		font-size: 0.74rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		color: var(--consulting-dim);
	}

	.consulting__capability h3 {
		margin: 0 0 0.9rem;
		font-size: clamp(1.25rem, 1.8vw, 1.65rem);
		font-weight: 600;
		line-height: 1.08;
		letter-spacing: -0.025em;
	}

	.consulting__capability p {
		max-width: 31rem;
		margin: 0;
		font-size: clamp(0.96rem, 1.2vw, 1.08rem);
		line-height: 1.6;
		color: var(--consulting-muted);
	}

	.consulting__visual {
		min-height: 39.25rem;
		margin: 0;
		overflow: hidden;
		border: 1px solid var(--consulting-rule);
		border-radius: 1rem;
		background: var(--color-surface);
	}

	.consulting__visual img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 900ms cubic-bezier(0.22, 1, 0.36, 1), filter 300ms ease;
	}

	.consulting__visual:hover img {
		transform: scale(1.035);
		filter: saturate(1.08);
	}

	@media (max-width: 1000px) {
		.consulting__header {
			grid-template-columns: minmax(10rem, 0.65fr) minmax(0, 1.6fr);
		}

		.consulting__body {
			grid-template-columns: 1fr;
		}

		.consulting__visual {
			min-height: 0;
			aspect-ratio: 16 / 10;
		}
	}

	@media (max-width: 680px) {
		.consulting {
			padding: 6rem 1rem;
		}

		.consulting__header {
			grid-template-columns: 1fr;
			gap: 2rem;
			margin-bottom: 3.5rem;
		}

		.consulting__marker {
			padding-top: 0;
		}

		.consulting__header h2 {
			font-size: clamp(4rem, 18vw, 5.6rem);
		}

		.consulting__grid {
			grid-template-columns: 1fr;
		}

		.consulting__capability {
			min-height: 17rem;
			padding: 2rem;
		}

		.consulting__capability:nth-child(odd) {
			border-right: 0;
		}

		.consulting__capability:nth-child(-n + 3) {
			border-bottom: 1px solid var(--consulting-rule);
		}

		.consulting__visual {
			aspect-ratio: 4 / 5;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.consulting__header h2 {
			background: none;
			color: var(--consulting-ink);
		}

		.consulting__visual img {
			transition: none;
		}
	}
</style>
