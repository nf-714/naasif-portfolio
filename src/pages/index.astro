---
import Hero from "../../components/Hero.astro";
import MenuPanel from "../../components/MenuPanel.astro";
import ProfileMarquee from "../../components/ProfileMarquee.astro";
import About from "../../components/About.astro";
import AboutNasif from "../../components/AboutNasif.astro";
import CurrentFocus from "../../components/CurrentFocus.astro";
import Testimonials from "../../components/Testimonials.astro";
import Services from "../../components/Services.astro";
import SelectedSystems from "../../components/SelectedSystems.astro";
import Consulting from "../../components/Consulting.astro";
import HowWeWork from "../../components/HowWeWork.astro";
import CallToAction from "../../components/CallToAction.astro";
import Tools from "../../components/Tools.astro";
import Roles from "../../components/Roles.astro";
import Footer from "../../components/Footer.astro";
import ScrollMotion from "../../components/ScrollMotion.astro";
import "../styles/global.css";

const siteURL = "https://naasif.com";
const pageTitle = "Nasif Fuad | Applied AI & Growth Specialist";
const pageDescription =
	"Nasif Fuad is an Applied AI & Growth Specialist building AI automation, GTM systems, lead-generation tools, and analytics workflows.";
const canonicalURL = `${siteURL}/`;
const socialImageURL = `${siteURL}/og-image.png`;

const structuredData = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "WebSite",
			"@id": `${siteURL}/#website`,
			url: canonicalURL,
			name: "Nasif Fuad",
			description: pageDescription,
			inLanguage: "en",
		},
		{
			"@type": "ProfilePage",
			"@id": `${siteURL}/#profile-page`,
			url: canonicalURL,
			name: pageTitle,
			isPartOf: { "@id": `${siteURL}/#website` },
			mainEntity: {
				"@type": "Person",
				"@id": `${siteURL}/#person`,
				name: "Nasif Fuad",
				url: canonicalURL,
				image: `${siteURL}/icon.png`,
				jobTitle: "Applied AI & Growth Specialist",
				description: pageDescription,
				knowsAbout: [
					"AI engineering",
					"AI automation",
					"Go-to-market systems",
					"Lead generation",
					"Business analytics",
				],
			},
		},
	],
};
---

<html lang="en" data-font-theme="legacy">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{pageTitle}</title>
		<meta name="description" content={pageDescription} />
		<meta name="author" content="Nasif Fuad" />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
		<meta name="theme-color" content="#ffffff" />

		<link rel="canonical" href={canonicalURL} />
		<link rel="icon" type="image/png" sizes="96x96" href="/icon-v2.png" />
		<link rel="apple-touch-icon" href="/icon-v2.png" />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Nasif Fuad" />
		<meta property="og:locale" content="en_US" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={pageDescription} />
		<meta property="og:image" content={socialImageURL} />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Nasif Fuad, Applied AI & Growth Specialist" />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={pageDescription} />
		<meta name="twitter:image" content={socialImageURL} />
		<meta name="twitter:image:alt" content="Nasif Fuad, Applied AI & Growth Specialist" />

		<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
	</head>
	<body>
		<main>
			<MenuPanel />
			<Hero />
			<ProfileMarquee />
			<About />
			<AboutNasif />
			<SelectedSystems />
			<Services />
			<Consulting />
			<HowWeWork />
			<CurrentFocus />
			<Testimonials />
			<Tools />
			<Roles />
			<CallToAction />
		</main>
		<Footer />
		<ScrollMotion />
	</body>
</html>
